@using Microsoft.AspNetCore.Identity
@model Tenant
@{
    ViewData["Title"] = "Update Password";
}
    @section Styles {
<style>
.link-nav a, 
        .card-dashboard {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border: none;
            padding: 30px;
            margin-bottom: 30px;
        }
        .primary-btn {
            background: #f8b600;
            border: none;
            padding: 10px 28px;
            font-weight: 600;
            border-radius: 30px;
            color: #222;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
            .primary-btn:hover {
                background: #e0a800;
                color: #111;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(248,182,0,0.3);
            }
        .outline-btn {
            background: transparent;
            border: 2px solid #f8b600;
            padding: 8px 20px;
            font-weight: 600;
            border-radius: 30px;
            color: #f8b600;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
            .outline-btn:hover {
                background: #f8b600;
                color: #222;
            }
        .form-group label {
            font-weight: 500;
            color: #333;
        }
        .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 12px 15px;
            font-family: 'Poppins', sans-serif;
        }
            .form-control:focus {
                border-color: #f8b600;
                box-shadow: 0 0 0 0.2rem rgba(248,182,0,0.25);
            }
        .password-requirements {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 5px;
        }
        @@media (max-width: 768px) {
        }
</style>
}
    <!-- Banner -->
    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">Update Password</h1>
                    <p class="text-white link-nav">
                        <a href="/">Home</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <a href="/identity/profile">Profile</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <label>Change Password</label>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Main Content -->
    <section class="section-gap">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <!-- Error Messages -->
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["error"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }
                    <!-- Password Form -->
                    <div class="card-dashboard">
                        <h4 class="mb-3"><i class="fas fa-key"></i> Change Password</h4>
                        <p class="text-muted">Enter your current password and choose a new one.</p>
                        <form method="post" action="@Url.Action("UpdatePassword", "Profile", new { area = "Identity" })">
                            @Html.AntiForgeryToken()
                            <!-- Hidden fields to preserve user identity -->
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="UserName" />
                            <input type="hidden" asp-for="Email" />
                            <!-- Add other hidden fields if needed -->
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" name="oldPassword" class="form-control" placeholder="Enter current password" required />
                            </div>
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" name="password" id="newPassword" class="form-control" placeholder="Enter new password" required minlength="6" />
                                <div class="password-requirements">Must be at least 6 characters.</div>
                            </div>
                            <div class="form-group">
                                <label>Confirm New Password</label>
                                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" required />
                                <div id="passwordMatchError" class="text-danger" style="display:none; font-size:0.8rem;">Passwords do not match.</div>
                            </div>
                            <div class="form-group text-center mt-4">
                                <button type="submit" class="primary-btn"><i class="fas fa-save"></i> Update Password</button>
                                <a href="@Url.Action("Index", "Profile", new { area = "Identity" })" class="outline-btn ml-2"><i class="fas fa-times"></i> Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
@section Scripts {
<script>
        // Simple client-side password confirmation check
        document.getElementById('confirmPassword').addEventListener('input', function() {
            var newPwd = document.getElementById('newPassword').value;
            var confirmPwd = this.value;
            var errorDiv = document.getElementById('passwordMatchError');
            if (newPwd !== confirmPwd) {
                errorDiv.style.display = 'block';
                this.setCustomValidity('Passwords do not match.');
            } else {
                errorDiv.style.display = 'none';
                this.setCustomValidity('');
            }
        });
        // Ensure new password is at least 6 characters
        document.getElementById('newPassword').addEventListener('input', function() {
            if (this.value.length < 6) {
                this.setCustomValidity('Password must be at least 6 characters.');
            } else {
                this.setCustomValidity('');
            }
        });
    </script>
}
