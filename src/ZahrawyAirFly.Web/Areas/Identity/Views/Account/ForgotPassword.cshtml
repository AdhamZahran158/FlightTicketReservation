@model ForgotPasswordVM
<!-- start banner Area -->
<section class="about-banner relative">
    <div class="overlay overlay-bg"></div>
    <div class="container">
        <div class="row d-flex align-items-center justify-content-center">
            <div class="about-content col-lg-12">
                <h1 class="text-white">
                    Forgot Password
                </h1>
                <p class="text-white link-nav">
                    <a href="/user/home">Home</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <a href="/identity/account/login"> Sign In</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <label> Forgot Password</label>
                </p>
            </div>
        </div>
    </div>
</section>
<!-- End banner Area -->
<!-- Start Forgot Password Area -->
<section class="section-gap">
    <div class="container">
        <div class="row d-flex justify-content-center">
            <div class="menu-content pb-40 col-lg-8">
                <div class="title text-center">
                    <h1 class="mb-10">Reset Your Password</h1>
                    <p>Enter your email address and we'll send you a link to reset your password</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="forgot-form">
                    <form asp-controller="Account" asp-action="ForgotPassword" asp-area="Identity" method="post" class="form">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" class="form-control" placeholder="Enter your registered email address" required value="@Model?.Email" name="Email">
                            <small class="form-text text-muted">We'll send a password reset link to this email</small>
                        </div>
                        <div class="form-group text-center mt-4">
                            <button type="submit" class="primary-btn text-uppercase">Send Reset Link</button>
                        </div>
                        <div class="text-center mt-3">
                            <p class="mb-0">
                                <a href="/identity/account/login" class="back-to-login">
                                    <i class="fa fa-arrow-left"></i> Back to Sign In
                                </a>
                            </p>
                        </div>
                    </form>
                    <!-- Success Message (hidden by default, show after form submission) -->
                    <div class="success-message text-center mt-4" style="display: none;">
                        <div class="alert alert-success">
                            <i class="fa fa-check-circle"></i>
                            <p class="mb-0 mt-2">Password reset link has been sent to your email address. Please check your inbox.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Forgot Password Area -->
@section Styles {
<style>
.forgot-form {
        background: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
        .forgot-form .form-group {
            margin-bottom: 25px;
        }
        .forgot-form label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
        }
        .forgot-form .primary-btn {
            padding: 12px 40px;
            font-size: 14px;
            min-width: 200px;
        }
        .forgot-form .back-to-login {
            color: #f8b600;
            font-size: 14px;
            display: inline-block;
            transition: all 0.3s ease;
        }
            .forgot-form .back-to-login i {
                margin-right: 5px;
            }
            .forgot-form .back-to-login:hover {
                color: #f8b600;
                text-decoration: underline;
            }
        .forgot-form .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
            padding: 15px;
            border-radius: 5px;
        }
            .forgot-form .alert-success i {
                font-size: 24px;
            }
        .forgot-form .form-text {
            font-size: 12px;
            margin-top: 5px;
        }
</style>
}
@section Scripts {
<script>
    // Handle form submission
    document.querySelector('.forgot-form form').addEventListener('submit', function(e) {
        // Don't prevent default - let the form submit normally to the server
        // Just validate email before submission
        var email = this.querySelector('input[type="email"]').value;
        if (!email || email.trim() === '') {
            e.preventDefault();
            alert('Please enter your email address');
            return false;
        }
        // Let the form submit normally - the server will handle the response
        return true;
    });
</script>
}
