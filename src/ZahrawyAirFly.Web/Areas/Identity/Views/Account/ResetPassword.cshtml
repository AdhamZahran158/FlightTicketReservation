@model ResetPasswordVM
<!-- start banner Area -->
<section class="about-banner relative">
    <div class="overlay overlay-bg"></div>
    <div class="container">
        <div class="row d-flex align-items-center justify-content-center">
            <div class="about-content col-lg-12">
                <h1 class="text-white">
                    Reset Password
                </h1>
                <p class="text-white link-nav">
                    <a href="index.html">Home</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <a href="login.html"> Sign In</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <label> Reset Password</label>
                </p>
            </div>
        </div>
    </div>
</section>
<!-- End banner Area -->
<!-- Start Reset Password Area -->
<section class="section-gap">
    <div class="container">
        <div class="row d-flex justify-content-center">
            <div class="menu-content pb-40 col-lg-8">
                <div class="title text-center">
                    <h1 class="mb-10">Create New Password</h1>
                    <p>Please enter your new password below</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="reset-form">
                    <form asp-action="ResetPassword" asp-area="Identity" asp-controller="Account" method="post" class="form">
                        @Html.AntiForgeryToken()
                        <!-- Hidden fields for UserId and token -->
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" name="token" value="@ViewBag.Token" />
                        <div class="form-group">
                            <label asp-for="Password"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your new password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group text-center mt-4">
                            <button type="submit" class="primary-btn text-uppercase">Reset Password</button>
                        </div>
                        <div class="text-center mt-3">
                            <p class="mb-0">
                                <a href="login.html" class="back-to-login">
                                    <i class="fa fa-arrow-left"></i> Back to Sign In
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Reset Password Area -->
@section Styles {
<style>
.reset-form {
        background: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
        .reset-form .form-group {
            margin-bottom: 25px;
        }
        .reset-form label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
        }
        .reset-form .primary-btn {
            padding: 12px 40px;
            font-size: 14px;
            min-width: 200px;
            background: #f8b600;
            border: none;
            border-radius: 30px;
            color: #222;
            font-weight: 600;
            transition: 0.3s;
            cursor: pointer;
        }
            .reset-form .primary-btn:hover {
                background: #e0a800;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(248,182,0,0.3);
            }
        .reset-form .back-to-login {
            color: #f8b600;
            font-size: 14px;
            display: inline-block;
            transition: all 0.3s ease;
            text-decoration: none;
        }
            .reset-form .back-to-login i {
                margin-right: 5px;
            }
            .reset-form .back-to-login:hover {
                color: #f8b600;
                text-decoration: underline;
            }
        .reset-form .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 12px 15px;
            font-family: 'Poppins', sans-serif;
            width: 100%;
        }
            .reset-form .form-control:focus {
                border-color: #f8b600;
                box-shadow: 0 0 0 0.2rem rgba(248,182,0,0.25);
                outline: none;
            }
    .text-danger {
        font-size: 12px;
        margin-top: 5px;
        display: block;
        color: #dc3545;
    }
</style>
}
@section Scripts {
<script>
    // Client-side validation
    document.querySelector('form')?.addEventListener('submit', function(e) {
        var password = document.getElementById('Password');
        var confirmPassword = document.getElementById('ConfirmPassword');
        if (!password.value) {
            e.preventDefault();
            alert('Please enter your new password');
            password.focus();
            return false;
        }
        if (password.value.length < 6) {
            e.preventDefault();
            alert('Password must be at least 6 characters long');
            password.focus();
            return false;
        }
        if (!confirmPassword.value) {
            e.preventDefault();
            alert('Please confirm your password');
            confirmPassword.focus();
            return false;
        }
        if (password.value !== confirmPassword.value) {
            e.preventDefault();
            alert('Passwords do not match');
            confirmPassword.focus();
            return false;
        }
        return true;
    });
    // Auto-focus on password field
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('Password')?.focus();
    });
</script>
}
