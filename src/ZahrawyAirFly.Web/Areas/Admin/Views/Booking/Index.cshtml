@using ZahrawyAirFly.Domain.Entities
@using ZahrawyAirFly.Domain.Enums
@model IEnumerable<Booking>
@{
    ViewData["Title"] = "All Bookings";
    var userEmails = ViewBag.UserEmails as Dictionary<string, string> ?? new Dictionary<string, string>();
}
    @section Styles {
<style>
        .table th {
            background: #f8f9fa;
        }
        .badge-pill {
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .badge-confirmed {
            background: #d4edda;
            color: #155724;
        }
        .badge-pending {
            background: #fff3cd;
            color: #856404;
        }
        .badge-cancelled {
            background: #f8d7da;
            color: #721c24;
        }
        .badge-refunded {
            background: #cce5ff;
            color: #004085;
        }
        .action-buttons {
            display: flex;
            flex-wrap: nowrap;
            gap: 6px;
            align-items: center;
        }
        .btn-sm-outline {
            background: transparent;
            border: 1px solid #f8b600;
            padding: 3px 12px;
            border-radius: 20px;
            color: #f8b600;
            font-size: 0.75rem;
            white-space: nowrap;
            text-decoration: none;
            display: inline-block;
        }
            .btn-sm-outline:hover {
                background: #f8b600;
                color: #222;
                text-decoration: none;
            }
        .btn-sm-danger {
            background: #dc3545;
            border: none;
            padding: 3px 12px;
            border-radius: 20px;
            color: #fff;
            font-size: 0.75rem;
            white-space: nowrap;
            text-decoration: none;
            display: inline-block;
        }
            .btn-sm-danger:hover {
                background: #c82333;
                color: #fff;
                text-decoration: none;
            }
        .text-muted-cancelled {
            color: #6c757d;
            font-size: 0.75rem;
        }
        .search-form-inline {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }
            .search-form-inline input {
                border-radius: 30px;
                padding: 6px 16px;
                border: 1px solid #ced4da;
                min-width: 220px;
            }
            .search-form-inline button {
                border-radius: 30px;
                padding: 6px 20px;
            }
</style>
}
    <!-- Banner -->
    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">Bookings</h1>
                    <p class="text-white link-nav">
                        <a href="/admin/home">Home</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <a href="#">Bookings</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <label>All Bookings</label>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Main Content -->
    <section class="section-gap">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <h2><i class="fas fa-ticket-alt"></i> All Bookings</h2>
                <!-- Inline search form -->
                <form method="get" action="@Url.Action("GetUserBookingsByEmail")" class="search-form-inline">
                    <input type="email" name="email" placeholder="Enter user email..." required />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
                </form>
            </div>
            <hr>
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success">@TempData["success"]</div>
            }
            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger">@TempData["error"]</div>
            }
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Booking Ref</th>
                            <th>User (Email)</th>
                            <th>Flight #</th>
                            <th>Route</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Booked At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var b in Model)
                            {
                                var email = userEmails.GetValueOrDefault(b.Id, "N/A");
                                var route = $"{b.Flight?.OriginAirport?.IataCode} → {b.Flight?.DestinationAirport?.IataCode}";
                                var statusClass = b.Status.ToString().ToLower();
                                <tr>
                                    <td><strong>@b.BookingRef</strong></td>
                                    <td>@email</td>
                                    <td>@b.Flight?.FlightNumber</td>
                                    <td>@route</td>
                                    <td><span class="badge-pill badge-@statusClass">@b.Status</span></td>
                                    <td>$@b.TotalAmount.ToString("F2")</td>
                                    <td>@b.BookedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @if (b.Status != BookingStatus.Cancelled)
                                        {
                                            <div class="action-buttons">
                                                <a href="@Url.Action("ModifyBooking", new { id = b.Id })" class="btn-sm-outline">
                                                    <i class="fas fa-edit"></i> Modify
                                                </a>
                                                <a href="@Url.Action("CancelBooking", new { id = b.Id })" class="btn-sm-danger" onclick="return confirm('Cancel this booking?');">
                                                    <i class="fas fa-times"></i> Cancel
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted-cancelled">Cancelled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted">No bookings found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <a href="/admin/home/index" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </section>
    <footer style="background:#1e2756; color:#aaa; padding:20px 0; margin-top:20px;">
        <div class="container text-center">
            <p>&copy; @DateTime.UtcNow.Year TravelAir Admin. All rights reserved.</p>
        </div>
    </footer>
