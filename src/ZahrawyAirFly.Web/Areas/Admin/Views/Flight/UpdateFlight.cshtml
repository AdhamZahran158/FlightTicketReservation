@using ZahrawyAirFly.Domain.Entities
@model Flight
    <!-- Bootstrap 4 + Font Awesome -->
    @section Styles {
<style>
        .form-container {
            background: #fff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .form-group {
            margin-bottom: 25px;
        }
        label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
        }
        .required:after {
            content: " *";
            color: #dc3545;
        }
        .form-control, .custom-select {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 12px 15px;
            font-family: 'Poppins', sans-serif;
        }
            .form-control:focus, .custom-select:focus {
                border-color: #f8b600;
                box-shadow: 0 0 0 0.2rem rgba(248,182,0,0.25);
            }
        .primary-btn {
            background: #f8b600;
            border: none;
            padding: 12px 40px;
            font-weight: 600;
            border-radius: 30px;
            color: #222;
            transition: 0.3s;
            cursor: pointer;
        }
            .primary-btn:hover {
                background: #e0a800;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(248,182,0,0.3);
            }
        .secondary-btn {
            background: #6c757d;
            border: none;
            padding: 12px 30px;
            font-weight: 500;
            border-radius: 30px;
            color: white;
            transition: 0.3s;
            text-decoration: none;
            display: inline-block;
        }
            .secondary-btn:hover {
                background: #5a6268;
                color: #fff;
                text-decoration: none;
            }
        .info-text {
            font-size: 12px;
            color: #6c757d;
            margin-top: 5px;
        }
        .icon-input {
            position: relative;
        }
            .icon-input i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #f8b600;
            }
            .icon-input input, .icon-input select {
                padding-left: 40px;
            }
        .bage-row {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 5px;
        }
        .alert-warning {
            background: #fff3cd;
            border: none;
            border-radius: 10px;
            color: #856404;
        }
        @@media (max-width: 768px) {
            .form-container {
                padding: 25px;
            }
        }
</style>
}
    <!-- Banner -->
    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">Edit Flight</h1>
                    <p class="text-white link-nav">
                        <a href="/admin/home/index">Home</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <a href="/admin/flight/index">Flights</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <label>Edit Flight</label>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Edit Form -->
    <section class="section-gap">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <div class="title text-center">
                        <h1 class="mb-10">Update Flight Information</h1>
                        <p>Modify the details of the selected flight</p>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center mt-4">
                <div class="col-lg-10">
                    <div class="form-container">
                        <form asp-area="Admin" asp-controller="Flight" asp-action="UpdateFlight" method="post" id="flightForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Flight Number</label>
                                        <div class="icon-input">
                                            <i class="fas fa-hashtag"></i>
                                            <input name="FlightNumber" value="@Model.FlightNumber" class="form-control" placeholder="e.g., ZA101" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Aircraft</label>
                                        <div class="icon-input">
                                            <i class="fas fa-fighter-jet"></i>
                                            <select name="AircraftId" class="custom-select" required>
                                                <option value="">Select Aircraft</option>
                                                <!-- These options should come from ViewBag.Aircrafts -->
                                                @if (ViewBag.Aircrafts != null)
                                                {
                                                    foreach (var aircraft in ViewBag.Aircrafts)
                                                    {
                                                        if (Model.AircraftId == aircraft.Id)
                                                        {
                                                            <option value="@aircraft.Id" selected>@aircraft.Model</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@aircraft.Id">@aircraft.Model</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Origin Airport</label>
                                        <div class="icon-input">
                                            <i class="fas fa-plane-departure"></i>
                                            <select name="OriginAirportId" class="custom-select" required>
                                                <option value="">Select Origin</option>
                                                @if (ViewBag.Airports != null)
                                                {
                                                    foreach (var airport in ViewBag.Airports)
                                                    {
                                                        if (Model.OriginAirportId == airport.Id)
                                                        {
                                                            <option value="@airport.Id" selected>@airport.Name (@airport.IataCode)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@airport.Id">@airport.Name (@airport.IataCode)</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Destination Airport</label>
                                        <div class="icon-input">
                                            <i class="fas fa-plane-arrival"></i>
                                            <select name="DestinationAirportId" class="custom-select" required>
                                                <option value="">Select Destination</option>
                                                @if (ViewBag.Airports != null)
                                                {
                                                    foreach (var airport in ViewBag.Airports)
                                                    {
                                                        if (Model.DestinationAirportId == airport.Id)
                                                        {
                                                            <option value="@airport.Id" selected>@airport.Name (@airport.IataCode)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@airport.Id">@airport.Name (@airport.IataCode)</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Departure (UTC)</label>
                                        <div class="icon-input">
                                            <i class="fas fa-calendar-alt"></i>
                                            <input type="datetime-local" name="DepartureUtc" class="form-control" value="@Model.DepartureUtc" required />
                                        </div>
                                        <small class="info-text">Local time will be converted to UTC on server</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Arrival (UTC)</label>
                                        <div class="icon-input">
                                            <i class="fas fa-calendar-check"></i>
                                            <input type="datetime-local" name="ArrivalUtc" value="@Model.ArrivalUtc" class="form-control" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Gate</label>
                                        <input name="Gate" value="@Model.Gate" class="form-control" placeholder="e.g., B22" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Terminal</label>
                                        <input name="Terminal" value="@Model.Terminal" class="form-control" placeholder="e.g., 4" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Flight Status</label>
                                <select name="Status" class="custom-select">
                                    <option value="Scheduled">Scheduled</option>
                                    <option value="Delayed">Delayed</option>
                                    <option value="Boarding">Boarding</option>
                                    <option value="Departed">Departed</option>
                                    <option value="Arrived">Arrived</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                            <!-- Pricing Section -->
                            <div class="form-group">
                                <label>Base Prices (USD)</label>
                                <div class="bage-row">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">Economy</label>
                                                <input name="BasePriceEconomy" value="@Model.BasePriceEconomy" class="form-control" step="10" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">Business</label>
                                                <input name="BasePriceBusiness" value="@Model.BasePriceBusiness" class="form-control" step="10" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">First</label>
                                                <input name="BasePriceFirst" value="@Model.BasePriceFirst" class="form-control" step="10" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Baggage -->
                            <div class="form-group">
                                <label>Baggage Policy</label>
                                <div class="bage-row">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">Max Baggage (kg)</label>
                                                <input name="MaxBaggageKg" value="@Model.MaxBaggageKg" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">Free Baggage (kg)</label>
                                                <input name="FreeBaggageKg" value="@Model.FreeBaggageKg" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label class="small">Extra per kg ($)</label>
                                                <input name="ExtraBaggagePerKg" value="@Model.ExtraBaggagePerKg" class="form-control" step="0.01" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Confirmation -->
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="confirmUpdate" required>
                                    <label class="custom-control-label" for="confirmUpdate">
                                        I confirm that the updated flight details are accurate
                                    </label>
                                </div>
                            </div>
                            <div class="form-group text-center mt-4">
                                <button type="submit" class="primary-btn"><i class="fas fa-save"></i> Update Flight</button>
                                <a href="/admin/flight/index" class="secondary-btn ml-2"><i class="fas fa-times"></i> Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
@section Scripts {
<script>
        // Auto-format flight number to uppercase
        const flightInput = document.getElementById('FlightNumber');
        if (flightInput) {
            flightInput.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/\s/g, '');
            });
        }
        // Validate arrival > departure
        const depInput = document.getElementById('DepartureUtc');
        const arrInput = document.getElementById('ArrivalUtc');
        function validateTimes() {
            if (depInput.value && arrInput.value) {
                if (new Date(arrInput.value) <= new Date(depInput.value)) {
                    arrInput.setCustomValidity('Arrival must be after departure');
                    arrInput.reportValidity();
                } else {
                    arrInput.setCustomValidity('');
                }
            }
        }
        depInput.addEventListener('change', validateTimes);
        arrInput.addEventListener('change', validateTimes);
        // Simple client-side validation before submit
        document.getElementById('flightForm').addEventListener('submit', function(e) {
            const flightNum = document.getElementById('FlightNumber').value.trim();
            const origin = document.getElementById('OriginAirportId').value;
            const dest = document.getElementById('DestinationAirportId').value;
            if (!flightNum) { alert('Flight number is required'); e.preventDefault(); return false; }
            if (!origin) { alert('Origin airport is required'); e.preventDefault(); return false; }
            if (!dest) { alert('Destination airport is required'); e.preventDefault(); return false; }
            if (origin === dest) { alert('Origin and destination cannot be the same'); e.preventDefault(); return false; }
            if (!depInput.value || !arrInput.value) { alert('Departure and arrival times are required'); e.preventDefault(); return false; }
            return true;
        });
        // Small helper to format datetime-local value from server-side DateTime (already done by name)
    </script>
}
