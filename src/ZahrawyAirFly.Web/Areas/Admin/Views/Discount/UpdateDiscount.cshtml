@using ZahrawyAirFly.Domain.Entities
@model Discount
    @section Styles {
<style>
        .form-container {
            background: #fff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .form-group {
            margin-bottom: 25px;
        }
        label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
        }
        .required:after {
            content: " *";
            color: #dc3545;
        }
        .form-control, .custom-select {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 12px 15px;
            font-family: 'Poppins', sans-serif;
        }
            .form-control:focus, .custom-select:focus {
                border-color: #f8b600;
                box-shadow: 0 0 0 0.2rem rgba(248,182,0,0.25);
            }
        .primary-btn {
            background: #f8b600;
            border: none;
            padding: 12px 40px;
            font-weight: 600;
            border-radius: 30px;
            color: #222;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
            .primary-btn:hover {
                background: #e0a800;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(248,182,0,0.3);
            }
        .secondary-btn {
            background: #6c757d;
            border: none;
            padding: 12px 30px;
            font-weight: 500;
            border-radius: 30px;
            color: white;
            text-decoration: none;
            display: inline-block;
        }
            .secondary-btn:hover {
                background: #5a6268;
                color: #fff;
            }
        .info-text {
            font-size: 12px;
            color: #6c757d;
            margin-top: 5px;
        }
        .icon-input {
            position: relative;
        }
            .icon-input i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #f8b600;
            }
            .icon-input input, .icon-input select {
                padding-left: 40px;
            }
        .switch-group {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-top: 5px;
        }
        .usage-stats {
            background: #f8f9fa;
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        @@media (max-width: 768px) {
            .form-container {
                padding: 25px;
            }
        }
</style>
}
    <!-- Banner -->
    <section class="about-banner relative">
        <div class="overlay overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">Edit Discount</h1>
                    <p class="text-white link-nav">
                        <a href="/admin/home/index">Home</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <a href="/admin/discount/index">Discounts</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <label>Edit Discount</label>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Edit Form -->
    <section class="section-gap">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <div class="col-lg-8">
                    <div class="title text-center">
                        <h1 class="mb-10">Update Discount Code</h1>
                        <p>Modify the discount rules and limits</p>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center mt-4">
                <div class="col-lg-10">
                    <div class="form-container">
                        <form asp-area="Admin" asp-controller="Discount" asp-action="UpdateDiscount" method="post" id="discountForm">
                            @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input type="hidden" name="TimesUsed" /> <!-- Preserve usage count -->
                            <!-- Usage Information (read-only) -->
                            <div class="usage-stats">
                                <div class="row">
                                    <div class="col-md-6">
                                        <small class="text-muted">Times Used</small>
                                        <div><strong>@Model.TimesUsed</strong></div>
                                    </div>
                                    <div class="col-md-6">
                                        <small class="text-muted">Created</small>
                                        <div><strong>@(Model.CreatedAt.ToString("dd MMM yyyy") ?? "N/A")</strong></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Discount Code</label>
                                        <div class="icon-input">
                                            <i class="fas fa-tag"></i>
                                            <input name="Code" class="form-control" placeholder="e.g., SUMMER2025" required />
                                        </div>
                                        <small class="info-text">Unique promotional code (uppercase letters/numbers)</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Description</label>
                                        <div class="icon-input">
                                            <i class="fas fa-align-left"></i>
                                            <input name="Description" class="form-control" placeholder="e.g., 15% off summer sale" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Discount Value</label>
                                        <div class="icon-input">
                                            <i class="fas fa-percent"></i>
                                            <input name="Value" type="number" step="0.01" class="form-control" required />
                                        </div>
                                        <small class="info-text">If percentage, enter number (e.g., 15 for 15%). If fixed, enter amount (e.g., 25.00).</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Discount Type</label>
                                        <div class="icon-input">
                                            <i class="fas fa-chart-line"></i>
                                            <select name="IsPercentage" class="custom-select">
                                                <option value="true">Percentage (%)</option>
                                                <option value="false">Fixed Amount ($)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Minimum Booking Amount ($)</label>
                                        <div class="icon-input">
                                            <i class="fas fa-dollar-sign"></i>
                                            <input name="MinBookingAmount" type="number" step="0.01" class="form-control" />
                                        </div>
                                        <small class="info-text">Minimum order value required to apply discount (0 = no minimum)</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Maximum Uses (0 = unlimited)</label>
                                        <div class="icon-input">
                                            <i class="fas fa-ticket-alt"></i>
                                            <input name="MaxUses" type="number" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Valid From</label>
                                        <div class="icon-input">
                                            <i class="fas fa-calendar-plus"></i>
                                            <input name="ValidFrom" type="datetime-local" class="form-control" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="required">Valid Until</label>
                                        <div class="icon-input">
                                            <i class="fas fa-calendar-times"></i>
                                            <input name="ValidUntil" type="datetime-local" class="form-control" required />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <div class="switch-group">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" id="isActiveSwitch" name="IsActive">
                                        <label class="custom-control-label" for="isActiveSwitch">Active</label>
                                    </div>
                                    <small class="info-text">Inactive discounts cannot be used in bookings</small>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="confirmDetails" required>
                                    <label class="custom-control-label" for="confirmDetails">
                                        I confirm that the updated discount details are accurate and comply with the terms of use
                                    </label>
                                </div>
                            </div>
                            <div class="form-group text-center mt-4">
                                <button type="submit" class="primary-btn"><i class="fas fa-save"></i> Update Discount</button>
                                <a href="/admin/discount/index" class="secondary-btn ml-2"><i class="fas fa-times"></i> Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Helpful Guidelines -->
            <div class="row justify-content-center mt-5">
                <div class="col-lg-10">
                    <div class="alert alert-info" style="background: #e8f4fd; border: none; border-radius: 10px;">
                        <h6><i class="fas fa-info-circle"></i> Discount Guidelines:</h6>
                        <ul class="mb-0 small">
                            <li><strong>Code:</strong> Use uppercase letters and numbers only (auto-uppercase applied).</li>
                            <li><strong>Percentage vs Fixed:</strong> Percentage discounts reduce the total by a percent; fixed discounts subtract a specific dollar amount.</li>
                            <li><strong>Minimum Booking:</strong> Discount applies only if the booking subtotal meets or exceeds this value.</li>
                            <li><strong>Maximum Uses:</strong> Set a limit or leave 0 for unlimited redemptions. Cannot be lower than current usage count.</li>
                            <li><strong>Times Used:</strong> This counter increments automatically and cannot be manually edited.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
@section Scripts {
<script>
        // Auto-uppercase discount code
        const codeInput = document.getElementById('Code');
        if (codeInput) {
            codeInput.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
            });
        }
        // Validate date range
        const fromInput = document.getElementById('ValidFrom');
        const untilInput = document.getElementById('ValidUntil');
        function validateDateRange() {
            if (fromInput.value && untilInput.value) {
                if (new Date(untilInput.value) <= new Date(fromInput.value)) {
                    untilInput.setCustomValidity('Valid Until must be after Valid From');
                    untilInput.reportValidity();
                } else {
                    untilInput.setCustomValidity('');
                }
            }
        }
        fromInput.addEventListener('change', validateDateRange);
        untilInput.addEventListener('change', validateDateRange);
        // Validate discount value positive
        const valueInput = document.getElementById('Value');
        if (valueInput) {
            valueInput.addEventListener('input', function() {
                if (parseFloat(this.value) <= 0) this.setCustomValidity('Discount value must be greater than 0');
                else this.setCustomValidity('');
            });
        }
        // Validate MaxUses >= TimesUsed (cannot reduce below already used count)
        const maxUsesInput = document.getElementById('MaxUses');
        const timesUsed = parseInt(document.querySelector('input[name="TimesUsed"]')?.value || 0);
        if (maxUsesInput) {
            maxUsesInput.addEventListener('input', function() {
                let val = parseInt(this.value);
                if (isNaN(val)) val = 0;
                if (val < 0) {
                    this.setCustomValidity('Max uses cannot be negative');
                } else if (val > 0 && val < timesUsed) {
                    this.setCustomValidity(`Max uses cannot be less than current usage (${timesUsed})`);
                } else {
                    this.setCustomValidity('');
                }
            });
        }
        // Form validation
        document.getElementById('discountForm').addEventListener('submit', function(e) {
            const code = document.getElementById('Code').value.trim();
            const value = parseFloat(document.getElementById('Value').value);
            if (!code) { alert('Discount code is required'); e.preventDefault(); return false; }
            if (isNaN(value) || value <= 0) { alert('Discount value must be greater than 0'); e.preventDefault(); return false; }
            const maxUses = parseInt(document.getElementById('MaxUses').value);
            if (!isNaN(maxUses) && maxUses > 0 && maxUses < timesUsed) {
                alert(`Maximum uses cannot be less than current usage (${timesUsed})`);
                e.preventDefault();
                return false;
            }
            if (!document.getElementById('confirmDetails').checked) {
                alert('Please confirm the discount details are correct');
                e.preventDefault();
                return false;
            }
            return true;
        });
    </script>
}
