                </div>
            </div>
        </div>
        <!-- ── KPI Row ── -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="kpi-card">
                    <div class="kpi-icon orange"><i class="fa fa-ticket"></i></div>
