<!-- Dashboard Content -->
<section class="section-gap" style="padding-top:36px;">
    <div class="container">
        <!-- ── Management Buttons Row ── -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card" style="padding:15px 20px; background:#f8f9fa;">
                    <div class="d-flex flex-wrap align-items-center gap-2">
