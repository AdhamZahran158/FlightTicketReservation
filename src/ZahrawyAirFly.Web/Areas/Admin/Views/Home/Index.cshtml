@using ZahrawyAirFly.Domain.Entities
@using ZahrawyAirFly.Domain.Enums
@model AdminHomeVM
@{
    var totalBookings = Model.TotalBookings;
    var totalRevenue = Model.Payments?.Where(p => p.Status == PaymentStatus.Completed).Sum(p => p.Amount) ?? 0;
    var activeFlights = Model.ActiveFlights;
    var totalPassengersToday = Model.Bookings?
        .Where(b => b.Flight?.DepartureUtc.Date == DateTime.UtcNow.Date && b.Status == BookingStatus.Confirmed)
        .SelectMany(b => b.BookingSeats)
        .Count() ?? 0;
    var statusCounts = Model.BookingStatusCounts;
    var totalCount = statusCounts.Values.Sum();
    var topRoutes = Model.TopRoutes;
    var recentBookings = Model.Bookings?
        .OrderByDescending(b => b.BookedAt)
        .Take(10)
        .ToList() ?? new List<Booking>();
    var todayFlights = Model.Flights?
        .Where(f => f.DepartureUtc.Date == DateTime.UtcNow.Date && f.Status != FlightStatus.Cancelled)
        .OrderBy(f => f.DepartureUtc)
        .Take(10)
        .ToList() ?? new List<Flight>();
    var airportCount = Model.Flights?.Select(f => f.OriginAirportId).Concat(Model.Flights?.Select(f => f.DestinationAirportId)).Distinct().Count() ?? 0;
    var aircraftCount = Model.Flights?.Select(f => f.AircraftId).Distinct().Count() ?? 0;
    var tenantCount = Model.Tenants?.Count ?? 0;
    // Monthly revenue data for chart (fix: handle null)
    var monthlyRevenue = (Model.Payments ?? Enumerable.Empty<Payment>())
        .Where(p => p.Status == PaymentStatus.Completed)
        .GroupBy(p => new { p.PaidAt?.Year, p.PaidAt?.Month })
        .Where(g => g.Key.Year.HasValue && g.Key.Month.HasValue)
        .Select(g => new { Month = new DateTime(g.Key.Year.Value, g.Key.Month.Value, 1), Total = g.Sum(p => p.Amount) })
        .OrderBy(x => x.Month)
        .ToList();
    // Generate chart data points (last 12 months)
    var months = Enumerable.Range(0, 12).Select(i => DateTime.UtcNow.AddMonths(-i).AddDays(1 - DateTime.UtcNow.Day)).Reverse().ToList();
    var chartData = months.Select(m => new { Month = m, Total = monthlyRevenue.FirstOrDefault(r => r.Month.Year == m.Year && r.Month.Month == m.Month)?.Total ?? 0 }).ToList();
    // Recent notifications from bookings (last 5)
    var notifications = new List<(string icon, string color, string title, string time, bool unread)>();
    foreach (var b in recentBookings.Take(5))
    {
        var statusText = b.Status.ToString();
        var icon = b.Status == BookingStatus.Confirmed ? "fa-check" : (b.Status == BookingStatus.Cancelled ? "fa-times" : "fa-info");
        var color = b.Status == BookingStatus.Confirmed ? "green" : (b.Status == BookingStatus.Cancelled ? "red" : "blue");
        var title = $"{b.BookingRef} {statusText}";
        var time = b.BookedAt.ToString("hh:mm tt");
        notifications.Add((icon, color, title, time, true));
    }
}
    @section Styles {
