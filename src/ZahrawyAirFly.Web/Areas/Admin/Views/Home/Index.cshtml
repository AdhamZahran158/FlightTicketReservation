            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="kpi-card">
                    <div class="kpi-icon green"><i class="fa fa-dollar"></i></div>
                    <div>
                        <div class="kpi-label">Revenue</div>
                        <div class="kpi-value">$@totalRevenue.ToString("N0")</div>
                        <div class="kpi-delta up"><i class="fa fa-arrow-up"></i> +12.1% this month</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="kpi-card">
                    <div class="kpi-icon blue"><i class="fa fa-plane"></i></div>
                    <div>
                        <div class="kpi-label">Active Flights</div>
