@using ZahrawyAirFly.Domain.Entities
@using ZahrawyAirFly.Domain.Enums
@model IEnumerable<Booking>
@{
    var now = DateTime.UtcNow;
    var upcoming = Model.Where(b => b.Flight?.DepartureUtc > now && b.Status != BookingStatus.Cancelled);
    var past = Model.Where(b => b.Flight?.DepartureUtc <= now || b.Status == BookingStatus.Cancelled);
}
    @section Styles {
<style>
        .card-dashboard {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border: none;
            padding: 25px;
            margin-bottom: 30px;
        }
        .booking-card {
            border-left: 4px solid #f8b600;
            margin-bottom: 20px;
            padding: 15px 20px;
            background: #fafafa;
            border-radius: 8px;
        }
            .booking-card.cancelled {
                border-left-color: #dc3545;
                opacity: 0.7;
            }
            .booking-card .flight-code {
                font-weight: 700;
                font-size: 1.2rem;
                color: #1e2756;
            }
            .booking-card .route {
                font-size: 0.95rem;
                color: #555;
            }
            .booking-card .passenger-info {
                font-size: 0.85rem;
                color: #666;
            }
            .booking-card .status-badge {
                font-size: 0.75rem;
                padding: 4px 12px;
                border-radius: 50px;
            }
        .status-confirmed {
            background: #d4edda;
            color: #155724;
        }
        .status-cancelled {
            background: #f8d7da;
            color: #721c24;
        }
        .status-pending {
            background: #fff3cd;
            color: #856404;
        }
        .btn-sm-outline {
            background: transparent;
            border: 1px solid #f8b600;
            padding: 4px 14px;
            border-radius: 20px;
            color: #f8b600;
            font-size: 0.8rem;
        }
            .btn-sm-outline:hover {
                background: #f8b600;
                color: #222;
            }
        .btn-sm-danger {
            background: #dc3545;
            border: none;
            padding: 4px 14px;
            border-radius: 20px;
            color: #fff;
            font-size: 0.8rem;
        }
            .btn-sm-danger:hover {
                background: #c82333;
            }
        .empty-state {
            text-align: center;
            padding: 40px 0;
            color: #999;
        }
            .empty-state i {
                font-size: 3rem;
                margin-bottom: 15px;
            }
        @@media (max-width: 576px) {
            .booking-card {
                padding: 12px;
            }
        }
</style>
}
    <!-- Banner -->
    <section class="about-banner relative">
        <div class="overlay-bg"></div>
        <div class="container">
            <div class="row d-flex align-items-center justify-content-center">
                <div class="about-content col-lg-12">
                    <h1 class="text-white">My Bookings</h1>
                    <p class="text-white link-nav">
                        <a href="/">Home</a>
                        <span class="lnr lnr-arrow-right"></span>
                        <label>My Bookings</label>
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Main Content -->
    <section class="section-gap">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <!-- Upcoming Bookings -->
                    <div class="card-dashboard">
                        <h4 class="mb-3"><i class="fas fa-calendar-alt"></i> Upcoming Flights</h4>
                        @if (upcoming.Any())
                        {
                            foreach (var booking in upcoming)
                            {
                                <div class="booking-card" data-booking-id="@booking.Id">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center">
                                        <div>
                                            <span class="flight-code">@booking.Flight?.FlightNumber</span>
                                            <span class="badge status-@booking.Status.ToString().ToLower() status-badge ml-2">@booking.Status</span>
                                        </div>
                                        <div>
                                            <span class="route">@booking.Flight?.OriginAirport?.IataCode → @booking.Flight?.DestinationAirport?.IataCode</span>
                                            <span class="text-muted ml-2">@booking.Flight?.DepartureUtc.ToString("dd MMM yyyy, HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <div class="passenger-info">
                                                <i class="fas fa-user"></i>
                                                @foreach (var seat in booking.BookingSeats)
                                                {
                                                    <span class="mr-2">@seat.PassengerName (Seat @seat.FlightSeat?.Seat?.SeatNumber)</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6 text-md-right">
                                            <a href="@Url.Action("Modify", "Booking", new { id = booking.Id })" class="btn-sm-outline mr-2"><i class="fas fa-edit"></i> Modify</a>
                                            <button class="btn-sm-danger cancel-btn" data-id="@booking.Id"><i class="fas fa-times"></i> Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-calendar-check"></i>
                                <h5>No upcoming bookings</h5>
                                <p>Start planning your next trip!</p>
                                <a href="/user/flight/search" class="primary-btn">Search Flights</a>
                            </div>
                        }
                    </div>
                    <!-- Past Bookings -->
                    <div class="card-dashboard">
                        <h4 class="mb-3"><i class="fas fa-history"></i> Past Flights</h4>
                        @if (past.Any())
                        {
                            foreach (var booking in past)
                            {
                                <div class="booking-card @(booking.Status == BookingStatus.Cancelled ? "cancelled" : "")">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center">
                                        <div>
                                            <span class="flight-code">@booking.Flight?.FlightNumber</span>
                                            <span class="badge status-@booking.Status.ToString().ToLower() status-badge ml-2">@booking.Status</span>
                                        </div>
                                        <div>
                                            <span class="route">@booking.Flight?.OriginAirport?.IataCode → @booking.Flight?.DestinationAirport?.IataCode</span>
                                            <span class="text-muted ml-2">@booking.Flight?.DepartureUtc.ToString("dd MMM yyyy, HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <div class="passenger-info">
                                                <i class="fas fa-user"></i>
                                                @foreach (var seat in booking.BookingSeats)
                                                {
                                                    <span class="mr-2">@seat.PassengerName (Seat @seat.FlightSeat?.Seat?.SeatNumber)</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6 text-md-right">
                                            @if (booking.Status != BookingStatus.Cancelled)
                                            {
                                                <a href="@Url.Action("Details", "Booking", new { id = booking.Id })" class="btn-sm-outline"><i class="fas fa-eye"></i> View</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Cancelled</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-clock"></i>
                                <h5>No past bookings</h5>
                                <p>Your flight history will appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <footer style="background:#1e2756; color:#aaa; padding:40px 0; margin-top:40px;">
        <div class="container text-center">
            <p>&copy; 2025 TravelAir. All rights reserved. | <a href="#" style="color:#f8b600;">Terms</a> | <a href="#" style="color:#f8b600;">Privacy</a></p>
        </div>
    </footer>
@section Scripts {
<script>
        document.querySelectorAll('.cancel-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                var bookingId = this.getAttribute('data-id');
                if (window.showConfirm) {
                    window.showConfirm(
                        'Cancel Booking',
                        'Are you sure you want to cancel this booking? This action cannot be undone.',
                        function() {
                            // Redirect to the Cancel action with the booking ID as query string
                            window.location.href = '@Url.Action("Cancel", "Booking")' + '?id=' + bookingId;
                        }
                    );
                } else {
                    // Fallback
                    if (confirm('Cancel this booking?')) {
                        window.location.href = '@Url.Action("Cancel", "Booking")' + '?id=' + bookingId;
                    }
                }
            });
        });
    </script>
}
