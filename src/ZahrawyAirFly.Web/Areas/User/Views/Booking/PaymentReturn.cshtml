@model ZahrawyAirFly.Domain.Entities.Booking
@{
    ViewData["Title"] = "تأكيد الدفع";
}
<div class="container mt-5 text-center">
    <div id="statusBox" class="card p-5 shadow-sm">
        <div id="loadingSpinner">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4>جاري تأكيد الدفع...</h4>
            <p class="text-muted">من فضلك انتظر، لا تغلق هذه الصفحة.</p>
        </div>
        <div id="successBox" class="d-none">
            <div class="text-success mb-3" style="font-size: 3rem;">✔</div>
            <h4 class="text-success">تم تأكيد الحجز بنجاح!</h4>
            <p>رقم الحجز: <strong>@Model.BookingRef</strong></p>
            <a asp-action="MyBookings" asp-controller="Booking" asp-area="User" class="btn btn-primary mt-3">
                عرض حجوزاتي
            </a>
        </div>
        <div id="pendingBox" class="d-none">
            <div class="text-warning mb-3" style="font-size: 3rem;">⏳</div>
            <h4>لسه بيتم التأكيد...</h4>
            <p class="text-muted">ممكن ياخد شوية ثواني إضافية. جرب تعمل رفرش للصفحة.</p>
            <button class="btn btn-outline-primary mt-3" onclick="location.reload()">تحديث الصفحة</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const bookingId = "@Model.Id";
        let attempts = 0;
        const maxAttempts = 10;
        async function checkStatus() {
            attempts++;
            try {
                const response = await fetch(`/User/Booking/CheckStatus?id=${bookingId}`);
                const data = await response.json();
                if (data.status === "Confirmed") {
                    document.getElementById("loadingSpinner").classList.add("d-none");
                    document.getElementById("successBox").classList.remove("d-none");
                    return;
                }
            } catch (e) {
                console.error(e);
            }
            if (attempts < maxAttempts) {
                setTimeout(checkStatus, 2000); // كرر كل 2 ثانية
            } else {
                document.getElementById("loadingSpinner").classList.add("d-none");
                document.getElementById("pendingBox").classList.remove("d-none");
            }
        }
        checkStatus();
    </script>
}
