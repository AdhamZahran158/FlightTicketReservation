@using ZahrawyAirFly.Domain.Entities
@using ZahrawyAirFly.Domain.Enums
@model List<FlightSeat>
@{
    var flight = ViewBag.Flight as Flight;
}
    @section Styles {
<style>
/* --- Same CSS as before (no changes) --- */
        .card-dashboard { background: #fff; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); border: none; padding: 30px; margin-bottom: 30px; }
        .primary-btn { background: #f8b600; border: none; padding: 10px 28px; font-weight: 600; border-radius: 30px; color: #222; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; cursor: pointer; }
        .primary-btn:hover { background: #e0a800; color: #111; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(248,182,0,0.3); }
        .outline-btn { background: transparent; border: 2px solid #f8b600; padding: 8px 20px; font-weight: 600; border-radius: 30px; color: #f8b600; display: inline-block; text-decoration: none; }
        .outline-btn:hover { background: #f8b600; color: #222; }
        .flight-summary { background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 25px; }
        .flight-summary .info { display: flex; flex-wrap: wrap; justify-content: space-between; }
        .aircraft-wrapper { display: flex; justify-content: center; padding: 20px 0; }
        .aircraft-fuselage {
            background: linear-gradient(180deg, #e9ecef 0%, #ced4da 100%);
            border-radius: 60% 60% 30% 30% / 80px 80px 30px 30px;
            padding: 25px 20px 30px 20px;
            max-width: 750px;
            width: 100%;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.05), 0 15px 35px rgba(0,0,0,0.1);
            border: 1px solid #b0b8c0;
        }
        .cockpit { text-align: center; font-size: 0.6rem; font-weight: 600; color: #495057; letter-spacing: 4px; background: #adb5bd; border-radius: 50% 50% 20% 20% / 30px 30px 10px 10px; width: 60%; margin: -35px auto 15px auto; padding: 8px 0 12px 0; border: 1px solid #8a929a; text-transform: uppercase; }
        .cabin { display: flex; flex-direction: column; align-items: center; gap: 5px; }
        .class-header { width: 100%; text-align: center; font-size: 0.7rem; font-weight: 700; color: #fff; padding: 4px 0; border-radius: 4px; margin: 5px 0; letter-spacing: 2px; }
        .class-first { background: #6f42c1; }
        .class-business { background: #007bff; }
        .class-economy { background: #28a745; }
        .seat-row { display: flex; justify-content: center; align-items: center; gap: 8px; width: 100%; }
        .seat-group { display: flex; gap: 5px; }
        .aisle { width: 28px; min-width: 28px; height: 100%; background: repeating-linear-gradient(90deg, #e9ecef 0px, #e9ecef 4px, #dee2e6 4px, #dee2e6 8px); border-radius: 4px; }
        .seat {
            width: 40px; height: 40px; border-radius: 6px 6px 10px 10px; display: flex; align-items: center; justify-content: center;
            font-size: 0.6rem; font-weight: 600; cursor: pointer; transition: 0.15s ease; border: 2px solid transparent;
            user-select: none; color: #222; position: relative;
        }
        .seat:hover:not(.seat-booked):not(.seat-blocked):not(.seat-maintenance):not(.seat-locked) { transform: scale(1.05); }
        .seat-available { background: #d4edda; border-color: #28a745; color: #155724; }
        .seat-available:hover { background: #b7e1c7; }
        .seat-booked { background: #f8d7da; border-color: #dc3545; color: #721c24; cursor: not-allowed; opacity: 0.6; }
        .seat-booked:hover { transform: none; }
        .seat-blocked { background: #e9ecef; border-color: #6c757d; color: #495057; cursor: not-allowed; opacity: 0.5; }
        .seat-blocked:hover { transform: none; }
        .seat-locked { background: #fff3cd; border-color: #ffc107; color: #856404; cursor: not-allowed; opacity: 0.7; }
        .seat-locked:hover { transform: none; }
        .seat-maintenance { background: #e9ecef; border-color: #6c757d; color: #495057; cursor: not-allowed; opacity: 0.4; }
        .seat-maintenance:hover { transform: none; }
        .seat-selected { background: #f8b600; border-color: #d39e00; color: #222; transform: scale(1.05); }
        .seat-selected:hover { background: #e0a800; }
        .seat-first::after { content: ''; position: absolute; top: -4px; right: -4px; width: 10px; height: 10px; background: #6f42c1; border-radius: 50%; border: 1px solid #fff; }
        .seat-business::after { content: ''; position: absolute; top: -4px; right: -4px; width: 10px; height: 10px; background: #007bff; border-radius: 50%; border: 1px solid #fff; }
        .seat-exit { border-bottom: 3px solid #dc3545; }
        .seat-window { border-top: 3px solid #00BFFF; }
        .seat-aisle { border-right: 3px solid #ffc107; }
        .exit-banner { display: flex; justify-content: space-between; padding: 0 10px; font-size: 0.55rem; font-weight: 600; color: #dc3545; letter-spacing: 1px; width: 100%; }
        .exit-banner span { background: #fff; padding: 0 10px; border-radius: 4px; border: 1px dashed #dc3545; }
        .tail-section { text-align: center; margin-top: 15px; padding: 12px 0 5px 0; background: #adb5bd; border-radius: 20% 20% 40% 40% / 10px 10px 30px 30px; width: 40%; margin-left: auto; margin-right: auto; font-size: 0.6rem; font-weight: 600; color: #495057; letter-spacing: 2px; border: 1px solid #8a929a; text-transform: uppercase; }
        .seat-legend { display: flex; justify-content: center; gap: 15px; margin-top: 15px; flex-wrap: wrap; }
        .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; }
        .legend-box { width: 18px; height: 18px; border-radius: 4px; }
        .legend-available { background: #d4edda; border: 1px solid #28a745; }
        .legend-booked { background: #f8d7da; border: 1px solid #dc3545; }
        .legend-blocked { background: #e9ecef; border: 1px solid #6c757d; }
        .legend-selected { background: #f8b600; border: 1px solid #d39e00; }
        .selected-seat-display { background: #f8f9fa; padding: 12px; border-radius: 8px; text-align: center; font-weight: 500; border-left: 4px solid #f8b600; }
        .user-info { background: #f8f9fa; padding: 15px 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #f8b600; }
        .user-info i { color: #f8b600; }
        @@media (max-width: 576px) {
            .aircraft-fuselage { padding: 15px 10px; border-radius: 30% 30% 20% 20% / 40px 40px 20px 20px; }
            .seat { width: 30px; height: 30px; font-size: 0.5rem; }
            .aisle { width: 18px; min-width: 18px; }
            .seat-group { gap: 3px; }
            .cockpit { width: 80%; }
        }
</style>
}
<!-- Banner -->
<section class="about-banner relative">
    <div class="overlay-bg"></div>
    <div class="container">
        <div class="row d-flex align-items-center justify-content-center">
            <div class="about-content col-lg-12">
                <h1 class="text-white">Flight Details & Seat Selection</h1>
                <p class="text-white link-nav">
                    <a href="/">Home</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <a href="/flight/search">Flights</a>
                    <span class="lnr lnr-arrow-right"></span>
                    <label>Book</label>
                </p>
            </div>
        </div>
    </div>
</section>
<!-- Main Content -->
<section class="section-gap">
    <div class="container">
        <div class="row">
            <!-- Flight Summary -->
            <div class="col-lg-4 order-lg-2">
                <div class="card-dashboard">
                    <h4 class="mb-3"><i class="fas fa-plane"></i> Flight Summary</h4>
                    <div class="flight-summary">
                        <div class="info"><span><strong>Flight:</strong> @flight?.FlightNumber</span><span><strong>Date:</strong> @flight?.DepartureUtc.ToString("dd MMM yyyy")</span></div>
                        <div class="info mt-2"><span><strong>From:</strong> @flight?.OriginAirport?.Name (@flight?.OriginAirport?.IataCode)</span><span><strong>To:</strong> @flight?.DestinationAirport?.Name (@flight?.DestinationAirport?.IataCode)</span></div>
                        <div class="info mt-2"><span><strong>Departure:</strong> @flight?.DepartureUtc.ToString("HH:mm")</span><span><strong>Arrival:</strong> @flight?.ArrivalUtc.ToString("HH:mm")</span></div>
                        <div class="info mt-2"><span><strong>Aircraft:</strong> @flight?.Aircraft?.Model</span><span><strong>Rows:</strong> @flight?.Aircraft?.Rows</span></div>
                    </div>
                    <div class="user-info">
                        <p class="mb-1"><i class="fas fa-user-circle"></i> <strong>Passenger</strong></p>
                        <p class="mb-0"><strong>@User.Identity.Name</strong></p>
                        <p class="mb-0 small text-muted">@User.FindFirst("Email")?.Value</p>
                    </div>
                    <div class="selected-seat-display" id="selectedSeatDisplay">
                        <i class="fas fa-chair"></i> No seat selected
                    </div>
                    <p class="text-muted small text-center mt-2">Click an available seat to select it, then confirm.</p>
                </div>
            </div>
            <!-- Seat Map -->
            <div class="col-lg-8 order-lg-1">
                <div class="card-dashboard">
                    <h4 class="mb-2"><i class="fas fa-chair"></i> Seat Map</h4>
                    <p class="text-muted">Select an available seat. Booked or blocked seats are not selectable.</p>
                    <div class="seat-legend">
                        <div class="legend-item"><span class="legend-box legend-available"></span> Available</div>
                        <div class="legend-item"><span class="legend-box legend-booked"></span> Booked</div>
                        <div class="legend-item"><span class="legend-box legend-blocked"></span> Blocked</div>
                        <div class="legend-item"><span class="legend-box legend-selected"></span> Selected</div>
                    </div>
                    <p class="text-center small text-muted">
                        <span class="badge badge-first" style="background:#6f42c1; color:#fff;">● First</span>
                        <span class="badge badge-business" style="background:#007bff; color:#fff;">● Business</span>
                        <span class="badge badge-economy" style="background:#28a745; color:#fff;">● Economy</span>
                    </p>
                    <div class="aircraft-wrapper">
                        <div class="aircraft-fuselage">
                            <div class="cockpit"><i class="fas fa-wifi"></i> COCKPIT</div>
                            <div class="cabin">
                                @{
                                    // Group FlightSeats by Seat Class
                                    var grouped = Model
                                        .Where(fs => fs.Seat != null)
                                        .OrderBy(fs => fs.Seat.Class)
                                        .ThenBy(fs => fs.Seat.Row)
                                        .ThenBy(fs => fs.Seat.Column)
                                        .GroupBy(fs => fs.Seat.Class)
                                        .ToList();
                                }
                                @foreach (var classGroup in grouped)
                                {
                                    var className = classGroup.Key.ToString();
                                    var classCss = className.ToLower();
                                    <div class="class-header class-@classCss">@className.ToUpper() CLASS</div>
                                    var seatsInClass = classGroup.OrderBy(fs => fs.Seat.Row).ThenBy(fs => fs.Seat.Column).ToList();
                                    int? currentRow = null;
                                    for (int i = 0; i < seatsInClass.Count; i++)
                                    {
                                        var flightSeat = seatsInClass[i];
                                        var seat = flightSeat.Seat;
                                        var row = seat.Row;
                                        if (currentRow != row)
                                        {
                                            if (currentRow.HasValue)
                                            {
                                                @:</div>
                                            }
                                            if (seat.IsExitRow)
                                            {
                                                <div class="exit-banner"><span>🟡 EMERGENCY EXIT</span><span>🟡 EMERGENCY EXIT</span></div>
                                            }
                                            @:<div class="seat-row">
                                            currentRow = row;
                                        }
                                        // Determine status
                                        string statusClass = "";
                                        bool isSelectable = false;
                                        switch (flightSeat.Status)
                                        {
                                            case SeatStatus.Available:
                                                statusClass = "seat-available";
                                                isSelectable = true;
                                                break;
                                            case SeatStatus.Booked:
                                                statusClass = "seat-booked";
                                                isSelectable = false;
                                                break;
                                            case SeatStatus.Blocked:
                                                statusClass = "seat-blocked";
                                                isSelectable = false;
                                                break;
                                            case SeatStatus.Locked:
                                                statusClass = "seat-locked";
                                                isSelectable = false;
                                                break;
                                            case SeatStatus.Maintenance:
                                                statusClass = "seat-maintenance";
                                                isSelectable = false;
                                                break;
                                            default:
                                                statusClass = "seat-available";
                                                isSelectable = true;
                                                break;
                                        }
                                        var seatClassCss = seat.Class.ToString().ToLower() == "first" ? "seat-first" :
                                                           (seat.Class.ToString().ToLower() == "business" ? "seat-business" : "");
                                        var exitCss = seat.IsExitRow ? "seat-exit" : "";
                                        var windowCss = seat.IsWindow ? "seat-window" : "";
                                        var aisleCss = seat.IsAisle ? "seat-aisle" : "";
                                        // ----- FIX: Use SeatNumber property -----
                                        var seatNumber = seat.SeatNumber; // <-- This is the correct seat label (e.g., "1A")
                                        <div class="seat @statusClass @seatClassCss @exitCss @windowCss @aisleCss"
                                             data-flightseat-id="@flightSeat.Id"
                                             data-seat-number="@seatNumber"
                                             data-class="@seat.Class"
                                             data-selectable="@(isSelectable ? "true" : "false")"
                                             title="@(seat.IsWindow ? "Window" : "") @(seat.IsAisle ? "Aisle" : "") @(seat.IsExitRow ? "Exit row" : "")"
                                             onclick="selectSeat(this)">
                                            @seatNumber
                                        </div>
                                        if (i == seatsInClass.Count - 1)
                                        {
                                            if (currentRow.HasValue)
                                            {
                                                @:</div>
                                            }
                                            currentRow = null;
                                        }
                                    }
                                }
                            </div>
                            <div class="tail-section"><i class="fas fa-restroom"></i> GALLEY / LAV</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Confirm Booking Form -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card-dashboard text-center">
                    <h4 class="mb-3"><i class="fas fa-check-circle"></i> Confirm Booking</h4>
                    <p class="text-muted">You are booking as <strong>@User.Identity.Name</strong> (@User.FindFirst("Email")?.Value)</p>
                    <form method="post" action="/User/Booking/Create" id="bookingForm">
                        @Html.AntiForgeryToken()
                        <!-- Hidden fields required for booking -->
                        <input type="hidden" name="flightId" value="@flight?.Id" />
                        <input type="hidden" name="baggageKg" value="0" />
                        <input type="hidden" name="agreedToTerms" value="true" />
                        <!-- Container for dynamic seat inputs -->
                        <div id="selectedSeatsContainer">
                            <!-- Hidden inputs will be added dynamically for each selected seat -->
                        </div>
                        <!-- Passenger details (optional, you can add if needed) -->
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="terms" required>
                                <label class="custom-control-label" for="terms">I confirm the selected seats and agree to the <a href="#">Terms & Conditions</a></label>
                            </div>
                        </div>
                        <button type="submit" class="primary-btn"><i class="fas fa-check-circle"></i> Confirm Booking</button>
                        <a href="/flight/search" class="outline-btn ml-2"><i class="fas fa-arrow-left"></i> Back</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<footer style="background:#1e2756; color:#aaa; padding:40px 0; margin-top:40px;">
    <div class="container text-center">
        <p>&copy; 2025 TravelAir. All rights reserved. | <a href="#" style="color:#f8b600;">Terms</a> | <a href="#" style="color:#f8b600;">Privacy</a></p>
    </div>
</footer>
@section Scripts {
<script>
    // Store selected FlightSeat IDs in an array
    var selectedSeats = [];
    function selectSeat(element) {
        if (element.dataset.selectable !== 'true') {
            alert('This seat is not available for selection.');
            return;
        }
        var flightSeatId = element.getAttribute('data-flightseat-id');
        var seatNumber = element.getAttribute('data-seat-number');
        var seatClass = element.getAttribute('data-class');
        // Check if already selected
        var index = selectedSeats.indexOf(flightSeatId);
        if (index === -1) {
            // Add to selection
            selectedSeats.push(flightSeatId);
            element.classList.add('seat-selected');
        } else {
            // Remove from selection
            selectedSeats.splice(index, 1);
            element.classList.remove('seat-selected');
        }
        // Update display
        updateSelectedDisplay();
    }
    function updateSelectedDisplay() {
        var display = document.getElementById('selectedSeatDisplay');
        var seatNumbers = [];
        document.querySelectorAll('.seat-selected').forEach(function(seat) {
            seatNumbers.push(seat.getAttribute('data-seat-number'));
        });
        if (seatNumbers.length === 0) {
            display.innerHTML = '<i class="fas fa-chair"></i> No seats selected';
        } else {
            display.innerHTML = '<i class="fas fa-chair"></i> Selected seats: ' + seatNumbers.join(', ');
        }
    }
    // Before submitting, create hidden inputs for each selected seat
    document.getElementById('bookingForm').addEventListener('submit', function(e) {
        if (selectedSeats.length === 0) {
            alert('Please select at least one seat before confirming.');
            e.preventDefault();
            return false;
        }
        if (!document.getElementById('terms').checked) {
            alert('Please agree to the Terms & Conditions.');
            e.preventDefault();
            return false;
        }
        // Clear previous hidden inputs
        var container = document.getElementById('selectedSeatsContainer');
        container.innerHTML = '';
        // Add a hidden input for each selected seat
        selectedSeats.forEach(function(id) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedSeats'; // This will bind to string[] selectedSeats
            input.value = id;
            container.appendChild(input);
        });
        return true;
    });
</script>
}
